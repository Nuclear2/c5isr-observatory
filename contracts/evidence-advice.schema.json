{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic collector evidence assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "evidence_ids", "source_count", "reason", "uncertainties"],
  "properties": {
    "action": { "type": "string", "enum": ["hold", "request_review", "conclude"] },
    "evidence_ids": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    },
    "source_count": { "type": "integer", "minimum": 0, "maximum": 32 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 800 },
    "uncertainties": {
      "type": "array", "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
